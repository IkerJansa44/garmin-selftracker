GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your_password
GARMIN_TOKENSTORE=/data/garmin-tokens
SQLITE_DB_PATH=/data/garmin.db
DEFAULT_SYNC_DAYS=2
DASHBOARD_URL=http://localhost:5180
DASHBOARD_PORT=5180
APP_BASE_PATH=/
ALLOWED_HOSTS=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your_smtp_password
# Optional timezone for container-local scheduling, e.g. Europe/Madrid
TZ=
